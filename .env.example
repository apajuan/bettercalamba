# MeiliSearch — Connects to the shared bettergovph search infrastructure
VITE_MEILISEARCH_HOST=https://search2.bettergov.ph
VITE_MEILISEARCH_PORT=443
VITE_MEILISEARCH_API_KEY=

# Cloudflare Pages Functions secrets (weather, etc.) are NOT loaded from
# `.env`. They are read by Wrangler from `.dev.vars` at the project root.
# See `.dev.vars.example` for the required keys (e.g. OPENWEATHERMAP_API_KEY).
